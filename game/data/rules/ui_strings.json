  "7001": {
   "name": "旁白",
   "text": "美丽的钱夫人终于实现了自己的人生两大理想，\n金钱多的不想要，男人排队要她挑！",
   "tags": [],
   "raw": "旁白           {  7001 , \"美丽的钱夫人终于实现了自己的人生两大理想，\\n金钱多的不想要，男人排队要她挑！\" }",
   "line": 183,
   "_comment": null
  },
  "7002": {
   "name": "钱夫人",
   "text": "人生的价值，取决于拥有金钱的多寡，\n哈哈......",
   "tags": [],
   "raw": "钱夫人         {  7002 , \"人生的价值，取决于拥有金钱的多寡，\\n哈哈......\" }",
   "line": 184,
   "_comment": null
  },
  "7011": {
   "name": "旁白",
   "text": "阿土伯用赚到的钱买了一个很大很大的农场，\n里面有很多水果、花卉，还有很多小动物，从此过着幸福的田园生活。",
   "tags": [],
   "raw": "旁白           {  7011 , \"阿土伯用赚到的钱买了一个很大很大的农场，\\n里面有很多水果、花卉，还有很多小动物，从此过着幸福的田园生活。\" }",
   "line": 188,
   "_comment": null
  },
  "7012": {
   "name": "阿土伯",
   "text": "傻人有傻福，呵呵～",
   "tags": [],
   "raw": "阿土伯         {  7012 , \"傻人有傻福，呵呵～\" }",
   "line": 189,
   "_comment": null
  },
  "7021": {
   "name": "旁白",
   "text": "成为大富翁之后的宫本宝藏对打理亿万家产并不感兴趣。\n不过让他高兴的是，自从有了钱以后可以买很多很多的宝刀。",
   "tags": [],
   "raw": "旁白           {  7021 , \"成为大富翁之后的宫本宝藏对打理亿万家产并不感兴趣。\\n不过让他高兴的是，自从有了钱以后可以买很多很多的宝刀。\" }",
   "line": 193,
   "_comment": null
  },
  "7022": {
   "name": "宫本宝藏",
   "text": "我要成为最优秀的武士，这一天就会来到。",
   "tags": [],
   "raw": "宫本宝藏       {  7022 , \"我要成为最优秀的武士，这一天就会来到。\" }",
   "line": 194,
   "_comment": null
  },
  "7031": {
   "name": "旁白",
   "text": "喜欢和动物相处的乌咪兴建了一座很大的森林动物保护公园，\n让所有的动物都快乐的生活在这里，免受人类的侵扰。\n据说乌咪的偶像泰山哥哥还特地寄来明信片赞扬她呢。",
   "tags": [],
   "raw": "旁白           {  7031 , \"喜欢和动物相处的乌咪兴建了一座很大的森林动物保护公园，\\n让所有的动物都快乐的生活在这里，免受人类的侵扰。\\n据说乌咪的偶像泰山哥哥还特地寄来明信片赞扬她呢。\" }",
   "line": 198,
   "_comment": null
  },
  "7032": {
   "name": "乌咪",
   "text": "希望大家和我一样爱护小动物哦！",
   "tags": [],
   "raw": "乌咪           {  7032 , \"希望大家和我一样爱护小动物哦！\" }",
   "line": 199,
   "_comment": null
  },
  "7041": {
   "name": "旁白",
   "text": "活泼可爱的孙小美成为大富翁之后，要做的第一件事，\n就是开一家中华美食饭店，让更多的人感受中华美食的魅力。",
   "tags": [],
   "raw": "旁白           {  7041 , \"活泼可爱的孙小美成为大富翁之后，要做的第一件事，\\n就是开一家中华美食饭店，让更多的人感受中华美食的魅力。\" }",
   "line": 203,
   "_comment": null
  },
  "7042": {
   "name": "孙小美",
   "text": "欢迎大家来捧场呀！",
   "tags": [],
   "raw": "孙小美         {  7042 , \"欢迎大家来捧场呀！\" }",
   "line": 204,
   "_comment": null
  },
  "7051": {
   "name": "旁白",
   "text": "金贝贝一直在努力收集小神仙，现在终于轻易实现了她的梦想，\n难道有钱真的能使鬼推磨吗？",
   "tags": [],
   "raw": "旁白           {  7051 , \"金贝贝一直在努力收集小神仙，现在终于轻易实现了她的梦想，\\n难道有钱真的能使鬼推磨吗？\" }",
   "line": 208,
   "_comment": null
  },
  "7052": {
   "name": "金贝贝",
   "text": "呵呵...哈哈...",
   "tags": [],
   "raw": "金贝贝         {  7052 , \"呵呵...哈哈...\" }",
   "line": 209,
   "_comment": null
  },
  "7061": {
   "name": "旁白",
   "text": "功成名就的小恐龙巴克力建造了一座仿真模型城市，\n自导自演了一部真正由恐龙担任主角的《哥斯拉》电影",
   "tags": [],
   "raw": "旁白           {  7061 , \"功成名就的小恐龙巴克力建造了一座仿真模型城市，\\n自导自演了一部真正由恐龙担任主角的《哥斯拉》电影\" }",
   "line": 213,
   "_comment": null
  },
  "7062": {
   "name": "小恐龙",
   "text": "我长大了也要当哥斯拉！",
   "tags": [],
   "raw": "小恐龙         {  7062 , \"我长大了也要当哥斯拉！\" }",
   "line": 214,
   "_comment": null
  },
  "7071": {
   "name": "旁白",
   "text": "自从超时空之旅失利之后闭门苦练三年的沙隆巴斯。\n今天终于如愿以偿重新成为大富翁，\n再一次成为美女们心目中的白马王子",
   "tags": [],
   "raw": "旁白           {  7071 , \"自从超时空之旅失利之后闭门苦练三年的沙隆巴斯。\\n今天终于如愿以偿重新成为大富翁，\\n再一次成为美女们心目中的白马王子\" }",
   "line": 218,
   "_comment": null
  },
  "7072": {
   "name": "沙隆巴斯",
   "text": "有付出必有回报\n我终于东山再起啦!",
   "tags": [],
   "raw": "沙隆巴斯       {  7072 , \"有付出必有回报\\n我终于东山再起啦!\" }",
   "line": 219,
   "_comment": null
  },
  "7081": {
   "name": "旁白",
   "text": "巨大的财富和成就并没有带给舞美拉意外的惊喜，\n她还是继续从事自己心爱的歌艺生涯......",
   "tags": [],
   "raw": "旁白           {  7081 , \"巨大的财富和成就并没有带给舞美拉意外的惊喜，\\n她还是继续从事自己心爱的歌艺生涯......\" }",
   "line": 223,
   "_comment": null
